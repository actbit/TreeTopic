{
	"name": "treetopic.client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"openapi:fetch": "curl http://localhost:5000/openapi/v1.json -o openapi.json",
		"openapi:generate": "openapi --input ./openapi.json --output ./src/lib/api/generated --client fetch",
		"generate:api": "npm run openapi:fetch && npm run openapi:generate"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/fabric": "^5.3.11",
		"@types/pdfjs-dist": "^2.10.377",
		"openapi-typescript-codegen": "^0.30.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@microsoft/signalr": "^10.0.0",
		"fabric": "^7.1.0",
		"pdfjs-dist": "^5.4.530"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
