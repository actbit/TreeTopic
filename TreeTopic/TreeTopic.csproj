<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>974af100-b0a1-49e8-adf1-8bdfdff3b69a</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Finbuckle.MultiTenant" Version="9.4.4" />
		<PackageReference Include="Finbuckle.MultiTenant.AspNetCore" Version="9.4.4" />
		<PackageReference Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="9.4.4" />

		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />

		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
		<PackageReference Include="NSwag.AspNetCore" Version="14.6.3" />
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
		<PackageReference Include="UUIDv47Sharp" Version="0.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TreeTopic.ServiceDefaults\TreeTopic.ServiceDefaults.csproj" />
		<ProjectReference Include="..\submodules\MaskedUUID\src\MaskedUUID.AspNetCore\MaskedUUID.AspNetCore.csproj" />
	</ItemGroup>

	<Target Name="NpmBuild" BeforeTargets="Build">
		<Message Text="#Start npm install" Importance="high" />
		<Exec Command="npm install" WorkingDirectory="./TreeTopic.Client" />
		<!-- Generate TypeScript client if openapi.json exists -->
		<Exec Command="npm run openapi:generate" WorkingDirectory="./TreeTopic.Client" Condition="Exists('TreeTopic.Client/openapi.json')" ContinueOnError="true" />
		<Message Text="#Start npm run build" Importance="high" />
		<RemoveDir Directories="wwwroot" />
		<Exec Command="npm run build" WorkingDirectory="./TreeTopic.Client" />
	</Target>

	<ItemGroup>
		<WwwrootFiles Include="wwwroot\**\*" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\**" CopyToPublishDirectory="Never" />
		<Content Update="ClientApp\**" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<Target Name="CopyPublish" AfterTargets="Publish">
		<Message Text="## Copy Vite build output" Importance="high" />
		<Copy SourceFiles="@(WwwrootFiles)" DestinationFiles="@(WwwrootFiles->'$(PublishDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
