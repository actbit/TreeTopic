  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TenantDb": "Host=localhost;Port=5432;Database=treetopic_tenants;User Id=postgres;Password=password;",
    "SharedApp": "Host=localhost;Port=5432;Database=treetopic_shared;User Id=postgres;Password=password;"
  },
  "Encryption": {
    "Key": "uxfNDZcInUBovLRutTt0qxhnkdEdNyU7ttXTnu6ImgU="
  },
